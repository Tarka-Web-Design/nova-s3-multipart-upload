{
    "name": "tarka-web-design/nova-s3-multipart-upload",
    "description": "A Laravel Nova resource tool to upload files directly to Amazon S3. A Nova 5 fork of ahmedkandel/nova-s3-multipart-upload.",
    "keywords": [
        "laravel",
        "nova",
        "aws",
        "s3",
        "upload"
    ],
    "license": "MIT",
    "authors": [{
        "name": "Ahmed Kandel"
    }],
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.0",
        "laravel/nova": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Ahmedkandel\\NovaS3MultipartUpload\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ahmedkandel\\NovaS3MultipartUpload\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
